    <exclude domain="database" path="runtime_state.db" />
    <exclude domain="database" path="runtime_state.db-shm" />
    <exclude domain="database" path="runtime_state.db-wal" />
    <exclude domain="database" path="runtime_state.db-journal" />
</full-backup-content>
