<?xml version="1.0" encoding="utf-8"?>
<!--
  権限は設計書 9.2 に従う。QUERY_ALL_PACKAGES・SYSTEM_ALERT_WINDOW・INTERNET・FOREGROUND_SERVICE は使わない。
  権限・ユーザー補助・バックアップを変えたら play-policy-reviewer に確認を頼む。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 残り時間・終了・解除待ちの通知（Android 13 以降は実行時に許可を求める） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 再起動のあとに通知と信頼時刻を戻す -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 任意：ミッション終了の通知を時刻ぴったりに出す。許可がなければ通常のアラーム（ロックの判定には使わない） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- 対象アプリを選ぶ一覧（ランチャーに出るアプリ）と、除外アプリ（既定のホーム・端末の設定・キーボード）の判定。9.2 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
    </queries>

    <application
        android:name=".DetoxApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dopagaki">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 報酬アプリの常時ロック（6.2、9.3）。画面の内容は読まない。設定は res/xml/accessibility_service.xml -->
        <service
            android:name=".lock.LockAccessibilityService"
            android:exported="false"
            android:label="@string/a11y_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>

        <receiver
            android:name=".notification.AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".notification.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
